{
	"metadata": [
		{
			"src": "src/VivLib/VivLib.csproj",
			"dest": "docs/api",
			"disableGitFeatures": false,
			"disableDefaultFilter": false
		}
	],
	"build": {
		"content": [
			{
				"files": [
					"docs/api/**.yml",
					"docs/api/index.md"
				]
			},
			{
				"files": [
					"docs/toc.yml",
					"docs/*.md"
				]
			}
		],
		"resource": [
			{
				"files": [
					"docs/images/**"
				]
			}
		],
		"overwrite": [
			{
				"files": [
					"docs/apidoc/**.md"
				],
				"exclude": [
					"docs/obj/**",
					"docs/_site/**"
				]
			}
		],
		"dest": "docs/_site",
		"globalMetadataFiles": [],
		"fileMetadataFiles": [],
		"template": [
			"default"
		],
		"postProcessors": [],
		"markdownEngineName": "markdig",
		"noLangKeyword": false,
		"keepFileLink": false,
		"cleanupCacheHistory": false,
		"disableGitFeatures": false
	}
}